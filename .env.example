# 复制为 .env 后供 docker compose 读取
# cp .env.example .env

# 诗人 API 端口（勿改，与 docker-compose 映射一致）
PORT=3921

# 可选：服务端统一配置 DeepSeek（App 里也可单独填）
DEEPSEEK_API_KEY=sk-你的密钥

# 可选：ZenMux（识图 / 云端听写）
ZENMUX_API_KEY=

# 可选：阿里云百炼 DashScope（Qwen3-TTS 朗读）
DASHSCOPE_API_KEY=sk-你的百炼密钥

# 可选：上下文 token 预算（默认 1000k 窗口、20k 输出预留、压缩摘要上限 100k）
# CONTEXT_WINDOW_TOKENS=1000000
# OUTPUT_RESERVE_TOKENS=20000
# COMPACT_SUMMARY_MAX_TOKENS=100000
